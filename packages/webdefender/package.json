{
  "name": "@oxygenlow/webdefender",
  "version": "1.11.1",
  "author": "Oxygen Low's Software",
  "description": "Oxygen Low's Software Web Defender: Protect your website or API from DDoS, injection attacks, bots, and malicious traffic.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hono": {
      "import": "./dist/hono.js",
      "types": "./dist/hono.d.ts"
    },
    "./next": {
      "import": "./dist/next.js",
      "types": "./dist/next.d.ts"
    },
    "./cloudflare": {
      "import": "./dist/cloudflare.js",
      "types": "./dist/cloudflare.d.ts"
    },
    "./worker": {
      "import": "./dist/cloudflare.js",
      "types": "./dist/cloudflare.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "ddos",
    "firewall",
    "waf",
    "bot-detection",
    "rate-limiting"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oxygen-Low/Oxygen-Lows-Software.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "7.0.2"
  }
}
