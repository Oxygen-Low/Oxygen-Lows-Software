{
  "name": "@oxygenlow/simplecookies",
  "version": "0.1.0",
  "author": "Oxygen Low's Software",
  "description": "SimpleCookies: 100% free cookie consent manager. Banner, script blocking, cookie scanner, consent receipts, and dashboard for any site.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./hono": {
      "import": "./dist/hono.js",
      "types": "./dist/hono.d.ts"
    },
    "./next": {
      "import": "./dist/next.js",
      "types": "./dist/next.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "ccpa",
    "cookie-consent",
    "cookie-banner",
    "consent-manager",
    "cmp"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oxygen-Low/Oxygen-Lows-Software.git"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "7.0.2"
  }
}
