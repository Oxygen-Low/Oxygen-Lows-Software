<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oxygen Low's Software" Height="720" Width="1280"
        Background="#1E1E1E" Foreground="#F1F1F1">
    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- Category Buttons Style -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App Cards Style -->
        <Style x:Key="AppCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless Button Style (Back buttons) -->
        <Style x:Key="BorderlessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Name="tabMain" SelectionChanged="TabMain_SelectionChanged">
            <TabItem Header="Web">
                <Border Name="webViewContainer" Background="#1E1E1E">
                    <TextBlock Name="txtLoading" Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </Border>
            </TabItem>
            <TabItem Name="appsTab" Header="Apps">
                <Grid Name="appsMainGrid" Background="#1E1E1E">
                    <!-- 1. AUTH WARNING VIEW -->
                    <Border Name="panelAuthWarning" Visibility="Visible" Background="#1E1E1E">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="40">
                            <TextBlock Text="🔒 Authenticated Access Required" FontSize="20" FontWeight="Bold" Foreground="#F1F1F1" Margin="0,0,0,10" TextAlignment="Center"/>
                            <TextBlock Text="Please sign in to your account under the 'Web' tab to access the desktop apps catalogue and your personal data." FontSize="14" Foreground="#A0A0A0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                            <Button Name="btnRetryAuth" Content="I have signed in, refresh" Width="200" Padding="10,6" Click="BtnRetryAuth_Click" Background="#2D2D2D" Foreground="#F1F1F1"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. APP CATALOG VIEW -->
                    <Grid Name="panelCatalog" Visibility="Collapsed" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Desktop Apps" FontSize="28" FontWeight="Bold" Foreground="#F1F1F1" Margin="0,0,0,5"/>
                            <TextBlock Text="Discover and use high-performance native desktop tools." FontSize="14" Foreground="#A0A0A0"/>
                        </StackPanel>

                        <!-- Category Selector -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="Categories" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ItemsControl Name="itemsCategories">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Width="110" Margin="0,0,10,10" Tag="{Binding Name}" Click="Category_Click" Style="{StaticResource CategoryButtonStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- App Grid -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Name="txtCategoryHeader" Text="All Apps" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <ItemsControl Name="itemsAppsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="280" Height="140" Margin="0,0,20,20" Tag="{Binding Id}" Click="AppCard_Click" Style="{StaticResource AppCardButtonStyle}">
                                                    <StackPanel Margin="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A0A0A0" TextWrapping="Wrap" MaxHeight="60"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Name="txtNoAppsMessage" Text="No apps found in this category." FontSize="14" Foreground="#707070" HorizontalAlignment="Left" Margin="0,15,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 3. CHATBOT VIEW -->
                    <Grid Name="panelChatbot" Visibility="Collapsed" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="← Back to Catalog" Click="BtnBackToCatalog_Click" Margin="0,0,15,0" Padding="12,6" Style="{StaticResource BorderlessButtonStyle}"/>
                            <TextBlock Grid.Column="1" Text="Chatbot App (Native)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Sidebar -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Content="+ New Chat" Click="BtnNewChat_Click" Margin="0,0,0,10" FontWeight="Bold" Padding="8"/>

                                <ListBox Grid.Row="1" Name="lstChats" SelectionChanged="LstChats_SelectionChanged" Background="#252526" BorderBrush="#3E3E42" Foreground="#F1F1F1" Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2" Width="200">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="✕" Width="20" Height="20" Click="BtnDeleteChat_Click" Tag="{Binding Id}" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                    <StackPanel Margin="0,5,0,0">
                                        <Label Content="Model:"/>
                                        <ComboBox Name="cmbModels" DisplayMemberPath="DisplayName" SelectionChanged="CmbModels_SelectionChanged" Margin="0,0,0,8" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42"/>

                                        <Label Content="Style:"/>
                                        <ComboBox Name="cmbStyles" DisplayMemberPath="title" SelectionChanged="CmbStyles_SelectionChanged" Margin="0,0,0,8" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42"/>

                                        <Label Content="LLM Character:"/>
                                        <ComboBox Name="cmbLlmCharacters" DisplayMemberPath="DisplayName" SelectionChanged="CmbLlmCharacters_SelectionChanged" Margin="0,0,0,8" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42"/>

                                        <Label Content="User Character:"/>
                                        <ComboBox Name="cmbUserCharacters" DisplayMemberPath="DisplayName" SelectionChanged="CmbUserCharacters_SelectionChanged" Margin="0,0,0,5" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Right Conversation area -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0" Name="scrollerMessages" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                    <ItemsControl Name="itemsMessages">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Margin="5" Padding="10" MaxWidth="600" HorizontalAlignment="{Binding Alignment}" Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RoleHeader}" FontSize="11" FontWeight="Bold" Foreground="#8A8A8A" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap" Foreground="#F1F1F1"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Send Controls -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Name="txtChatInput" KeyDown="TxtChatInput_KeyDown" Padding="8" Margin="0,0,5,0" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42" CaretBrush="#F1F1F1"/>
                                    <Button Grid.Column="1" Name="btnSendChat" Content="Send" Click="BtnSendChat_Click" FontWeight="Bold"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 4. FILE COMPRESSOR VIEW -->
                    <Grid Name="panelCompressor" Visibility="Collapsed" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="← Back to Catalog" Click="BtnBackToCatalog_Click" Margin="0,0,15,0" Padding="12,6" Style="{StaticResource BorderlessButtonStyle}"/>
                            <TextBlock Grid.Column="1" Text="File Compressor (Native)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left inputs -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="Source File (from Supabase storage):" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="cmbStorageFiles" DisplayMemberPath="name" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42" Padding="6"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="BtnRefreshStorageFiles_Click" Margin="5,0,0,0"/>
                                </Grid>

                                <Label Content="Compression Quality:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Name="sliderQuality" Minimum="10" Maximum="100" Value="70" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderQuality, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#29B6F6"/>
                                </Grid>

                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,15">
                                    <Button Content="30%" Click="BtnQualityPreset_Click" Tag="30" Margin="0,0,5,0"/>
                                    <Button Content="50%" Click="BtnQualityPreset_Click" Tag="50" Margin="0,0,5,0"/>
                                    <Button Content="70%" Click="BtnQualityPreset_Click" Tag="70" Margin="0,0,5,0"/>
                                    <Button Content="90%" Click="BtnQualityPreset_Click" Tag="90" Margin="0,0,0,0"/>
                                </UniformGrid>

                                <Label Content="Target Size (MB, optional):" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <TextBox Name="txtTargetSizeMB" Padding="6" Margin="0,0,0,15" Background="#2D2D2D" Foreground="#F1F1F1" BorderBrush="#3E3E42" CaretBrush="#F1F1F1"/>

                                <Button Name="btnStartCompression" Content="Start Compression" Click="BtnStartCompression_Click" Background="#0288D1" Foreground="#F1F1F1" Padding="12" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Right display: Status & Results -->
                            <Border Grid.Column="1" Margin="10,0,0,0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <!-- Idle/Initial State -->
                                    <StackPanel Name="panelCompressorIdle" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Ready to compress" FontSize="18" FontWeight="SemiBold" Foreground="#A0A0A0" TextAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="Select a file and adjust settings to see results here." FontSize="13" Foreground="#707070" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Working State -->
                                    <StackPanel Name="panelCompressorRunning" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar Name="progressCompressor" Width="180" Height="20" IsIndeterminate="True" Margin="0,0,0,10"/>
                                        <TextBlock Name="txtCompressorStatus" Text="Compressing your file..." FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Success State -->
                                    <StackPanel Name="panelCompressorSuccess" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Success" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" TextAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="File compressed and uploaded to storage." FontSize="14" Foreground="#A0A0A0" TextAlignment="Center" Margin="0,0,0,15"/>

                                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,10" Width="280">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Original Size:" Foreground="#A0A0A0"/>
                                                <TextBlock Grid.Column="1" Name="txtOrigSize" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,10" Width="280">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="New Size:" Foreground="#A0A0A0"/>
                                                <TextBlock Grid.Column="1" Name="txtNewSize" FontWeight="Bold" Foreground="#4CAF50"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,15" Width="280">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Savings:" Foreground="#A0A0A0"/>
                                                <TextBlock Grid.Column="1" Name="txtSavings" FontWeight="Bold" Foreground="#4CAF50"/>
                                            </Grid>
                                        </Border>

                                        <Button Content="Compress Another" Click="BtnCompressAnother_Click" Width="150" Padding="8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 5. VPN CLIENT VIEW -->
                    <Grid Name="panelVPN" Visibility="Collapsed" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Experimental Warning -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="← Back to Catalog" Click="BtnBackToCatalog_Click" Margin="0,0,15,0" Padding="12,6" Style="{StaticResource BorderlessButtonStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Oxygen Low's VPN" FontSize="20" FontWeight="Bold"/>
                                <Border Background="#D32F2F" CornerRadius="4" Margin="15,0,0,0" Padding="6,2">
                                    <TextBlock Text="EXPERIMENTAL: Limit 50MB/day" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Remaining Data: " Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <TextBlock Name="txtVPNRemainingData" Text="50.00 MB" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="1" Background="#3E3E42" Margin="0,0,0,10"/>

                        <!-- Core Split Layout -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Map and Status -->
                            <Grid Grid.Column="0" Margin="0,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Leaflet Map container -->
                                <Border Grid.Row="0" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Background="#1E1E1E">
                                    <Grid Name="vpnMapContainer">
                                        <!-- Leaflet web map dynamically added here -->
                                    </Grid>
                                </Border>

                                <!-- Connection and Settings Controls -->
                                <Grid Grid.Row="1" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Connection Button & Info -->
                                    <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Name="txtVPNSelectedServer" Text="No Server Selected" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Name="txtVPNServerIP" Text="IP: --.--.--.--" FontSize="12" Foreground="#A0A0A0"/>
                                                <TextBlock Name="txtVPNConnectionDuration" Text="Uptime: 00:00:00" FontSize="11" Foreground="#707070" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Name="btnVPNToggleConnection" Content="Connect" Click="BtnVPNToggleConnection_Click" Width="120" Height="45" Background="#2196F3" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Quick Settings -->
                                    <Border Grid.Column="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="15">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="VPN Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <CheckBox Name="chkVPNKillswitch" Content="Killswitch" Checked="ChkVPNSettingChanged" Unchecked="ChkVPNSettingChanged" Foreground="White" Margin="0,0,0,8" ToolTip="Completely disable internet when selected VPN is loading or unavailable."/>
                                            <CheckBox Name="chkVPNLimit" Content="Enforce 50MB Limit" Checked="ChkVPNSettingChanged" Unchecked="ChkVPNSettingChanged" Foreground="White" IsChecked="True" ToolTip="Disconnect and apply Killswitch when daily data usage exceeds 50MB."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Servers Sidebar -->
                            <Border Grid.Column="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Select Location" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl Name="itemsVPNServers">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,0,10" Tag="{Binding Id}" Click="BtnVPNServerSelect_Click" Style="{StaticResource AppCardButtonStyle}" Padding="10">
                                                        <Grid Width="250">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                                <TextBlock Text="{Binding DisplayIP}" FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontSize="11" Foreground="#707070" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Update">
                <StackPanel Margin="20">
                    <TextBlock Text="Updates" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Name="txtCurrentVersion" Text="Current Version: " Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBlock Name="txtUpdateStatus" Text="Click the button to check for updates." Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Button Name="btnCheckUpdate" Content="Check for Updates" Width="150" HorizontalAlignment="Left" Padding="10,5" Click="BtnCheckUpdate_Click"/>
                    <ProgressBar Name="progressBar" Height="20" Margin="0,10,0,0" Visibility="Collapsed" Maximum="100"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
