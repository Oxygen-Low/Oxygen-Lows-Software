<Window x:Class="DesktopInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oxygen Low's Software Installer" Height="300" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel Name="pnlInstall" Visibility="Collapsed">
            <TextBlock Text="Welcome to the Installer" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Installation Path:" Margin="0,0,0,5"/>
            <TextBox Name="txtInstallPath" Margin="0,0,0,20" Padding="5"/>
            <Button Name="btnInstall" Content="Install" Padding="10,5" Width="100" HorizontalAlignment="Right" Click="BtnInstall_Click"/>
        </StackPanel>
        
        <StackPanel Name="pnlManage" Visibility="Collapsed">
            <TextBlock Text="Manage Installation" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="An existing installation was detected. What would you like to do?" Margin="0,0,0,20" TextWrapping="Wrap"/>
            
            <UniformGrid Columns="2" Rows="2" VerticalAlignment="Top">
                <Button Name="btnUpdate" Content="Update" Margin="5" Padding="10" Click="BtnUpdate_Click"/>
                <Button Name="btnRepair" Content="Repair (Keep Data)" Margin="5" Padding="10" Click="BtnRepair_Click"/>
                <Button Name="btnReinstall" Content="Reinstall (Clear Data)" Margin="5" Padding="10" Click="BtnReinstall_Click"/>
                <Button Name="btnUninstall" Content="Uninstall" Margin="5" Padding="10" Click="BtnUninstall_Click"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel Name="pnlStatus" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Name="txtStatus" Text="Working..." FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <ProgressBar IsIndeterminate="True" Height="20" Margin="0,0,0,20"/>
            <Button Name="btnClose" Content="Close" Padding="10,5" Width="100" HorizontalAlignment="Center" Click="BtnClose_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
